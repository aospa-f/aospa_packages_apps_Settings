<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="ax_edge_volume_gesture_settings"
    android:title="@string/ax_edge_volume_gestures_title">

    <SwitchPreference
        android:key="ax_edge_volume_enabled"
        android:title="@string/ax_edge_volume_enabled_title"
        android:summary="@string/ax_edge_volume_enabled_summary"
        android:defaultValue="true" />

    <com.android.settings.widget.SeekBarPreference
        android:key="ax_edge_volume_step_dp"
        android:title="@string/ax_edge_volume_step_title"
        android:summary="@string/ax_edge_volume_step_summary"
        android:persistent="false" />

    <Preference
        android:key="ax_edge_volume_blocked_apps"
        android:title="@string/ax_edge_blocked_apps_title"
        android:summary="@string/ax_edge_blocked_apps_none"
        android:fragment="com.android.settings.gestures.AxEdgeVolumeBlocklistSettings" />

</PreferenceScreen>
