<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="ax_edge_panel_gesture_settings"
    android:title="@string/ax_edge_panel_gestures_title">

    <SwitchPreference
        android:key="ax_edge_panel_enabled"
        android:title="@string/ax_edge_panel_enabled_title"
        android:summary="@string/ax_edge_panel_enabled_summary"
        android:defaultValue="true" />

    <Preference
        android:key="ax_edge_panel_blocked_apps"
        android:title="@string/ax_edge_blocked_apps_title"
        android:summary="@string/ax_edge_blocked_apps_none"
        android:fragment="com.android.settings.gestures.AxEdgePanelBlocklistSettings" />

</PreferenceScreen>
