<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/tricky_store_title">

    <PreferenceCategory
        android:key="ts_rkp_category"
        android:title="@string/ts_rkp_title">

        <androidx.preference.SwitchPreferenceCompat
            android:key="ts_rkp_enabled"
            android:title="@string/ts_rkp_enabled"
            android:summary="@string/ts_rkp_enabled_summary"
            android:persistent="false" />

        <Preference
            android:key="ts_rkp_provision"
            android:title="@string/ts_rkp_provision"
            android:summary="@string/ts_rkp_provision_summary" />

        <Preference
            android:key="ts_rkp_status"
            android:title="@string/ts_rkp_status"
            android:summary="@string/ts_rkp_unavailable"
            android:selectable="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="ts_keybox_file_category"
        android:title="@string/ts_keybox_file_title">

        <Preference
            android:key="ts_keybox_file"
            android:title="@string/ts_keybox_file"
            android:summary="@string/ts_keybox_file_absent"
            android:selectable="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="ts_footer_category"
        android:title="@string/ts_footer_title">

        <com.android.settingslib.widget.FooterPreference
            android:key="ts_footer"
            android:title="@string/ts_footer_body"
            android:selectable="false" />
    </PreferenceCategory>

</PreferenceScreen>
